{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "flymacjets.com"
        }
      ],
      "destination": "https://jetwithmatt.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.flymacjets.com"
        }
      ],
      "destination": "https://jetwithmatt.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "macjets-site.vercel.app"
        }
      ],
      "destination": "https://jetwithmatt.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/guides/index.html",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/guides/",
      "permanent": true
    }
  ]
}
